# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma separated Telegram user IDs that get admin access inside the mini app
ADMIN_IDS=123456789

# Public HTTPS URL where the client (mini app) is hosted, used by the bot's
# "Open Shop" button and for validating Telegram WebApp requests
WEBAPP_URL=https://your-domain.example.com

# Port for the REST API
PORT=8787

# Set to "true" to skip Telegram initData signature checks (local dev only)
DEV_SKIP_AUTH=true
