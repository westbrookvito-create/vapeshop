# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma separated Telegram user IDs allowed to use the /admin bot commands
ADMIN_IDS=123456789

# Public HTTPS URL where the client (mini app) is hosted, used by the bot's
# "Open Shop" button and for validating Telegram WebApp requests
WEBAPP_URL=https://your-domain.example.com

# Port for the REST API
PORT=8787

# Base URL the bot uses to call the REST API. Defaults to http://localhost:PORT,
# override only if the bot and API run on different hosts.
API_BASE_URL=

# Set to "true" to skip Telegram initData signature checks (local dev only)
DEV_SKIP_AUTH=true
